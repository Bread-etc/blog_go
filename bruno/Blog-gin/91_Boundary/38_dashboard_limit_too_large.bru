meta {
  name: 38 Dashboard Limit Too Large
  type: http
  seq: 38
}

get {
  url: {{baseUrl}}/api/dashboard/top-posts?limit=51
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("dashboard top posts rejects limit above max", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("AGGREGATE_TOP_POSTS_LIMIT_INVALID");
    expect(res.body.data).to.equal(null);
  });
}
