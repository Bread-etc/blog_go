meta {
  name: 34 Link Update Not Found
  type: http
  seq: 34
}

put {
  url: {{baseUrl}}/api/links/not-found-link-{{runId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Boundary Link Not Found {{runId}}",
    "url": "https://example.com/not-found",
    "description": "",
    "sort": 0
  }
}

tests {
  test("link update not found returns 404", function () {
    expect(res.status).to.equal(404);
    expect(res.body.code).to.equal(404);
    expect(res.body.errorCode).to.equal("LINK_NOT_FOUND");
    expect(res.body.data).to.equal(null);
  });
}
