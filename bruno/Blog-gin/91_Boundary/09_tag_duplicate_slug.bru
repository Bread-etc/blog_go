meta {
  name: 09 Tag Duplicate Slug
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Boundary Tag Slug Duplicate {{runId}}",
    "slug": "boundary-tag-{{runId}}"
  }
}

tests {
  test("duplicate tag slug returns conflict", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal(409);
    expect(res.body.errorCode).to.equal("TAG_SLUG_EXISTS");
    expect(res.body.data).to.equal(null);
  });
}
