meta {
  name: 25 Post List Duplicate TagIds Repeat
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/posts?page=1&pageSize=10&tagIds={{boundaryTagId}}&tagIds={{boundaryTagId}}
  body: none
  auth: none
}

tests {
  test("post list rejects duplicated repeated tagIds", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("POST_TAG_IDS_INVALID");
    expect(res.body.data).to.equal(null);
  });
}
