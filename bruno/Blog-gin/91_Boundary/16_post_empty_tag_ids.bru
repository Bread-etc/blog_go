meta {
  name: 16 Post Empty TagIds
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Boundary Empty TagIds {{runId}}",
    "content": "content",
    "summary": "",
    "slug": "boundary-empty-tagids-{{runId}}",
    "cover": "",
    "categoryId": "{{boundaryCategoryId}}",
    "tagIds": [],
    "isPublished": true
  }
}

tests {
  test("post create requires at least one tag", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("POST_TAG_IDS_REQUIRED");
    expect(res.body.data).to.equal(null);
  });
}
