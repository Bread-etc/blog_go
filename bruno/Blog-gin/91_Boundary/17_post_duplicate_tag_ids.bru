meta {
  name: 17 Post Duplicate TagIds
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Boundary Duplicate TagIds {{runId}}",
    "content": "content",
    "summary": "",
    "slug": "boundary-duplicate-tagids-{{runId}}",
    "cover": "",
    "categoryId": "{{boundaryCategoryId}}",
    "tagIds": ["{{boundaryTagId}}", "{{boundaryTagId}}"],
    "isPublished": true
  }
}

tests {
  test("post create rejects duplicate tagIds", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("POST_TAG_IDS_INVALID");
    expect(res.body.data).to.equal(null);
  });
}
