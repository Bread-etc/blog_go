meta {
  name: 19 Post Summary Too Long
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Boundary Summary Too Long {{runId}}",
    "content": "content",
    "summary": "",
    "slug": "boundary-summary-too-long-{{runId}}",
    "cover": "",
    "categoryId": "{{boundaryCategoryId}}",
    "tagIds": ["{{boundaryTagId}}"],
    "isPublished": true
  }
}

tests {
  test("post summary length is validated", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("POST_SUMMARY_TOO_LONG");
    expect(res.body.data).to.equal(null);
  });
}
