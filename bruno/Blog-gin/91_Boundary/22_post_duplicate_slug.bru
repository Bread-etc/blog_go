meta {
  name: 22 Post Duplicate Slug
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Boundary Duplicate Slug {{runId}}",
    "content": "content",
    "summary": "",
    "slug": "{{boundaryPostSlug}}",
    "cover": "",
    "categoryId": "{{boundaryCategoryId}}",
    "tagIds": ["{{boundaryTagId}}"],
    "isPublished": true
  }
}

tests {
  test("duplicate post slug returns conflict", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal(409);
    expect(res.body.errorCode).to.equal("POST_SLUG_EXISTS");
    expect(res.body.data).to.equal(null);
  });
}
