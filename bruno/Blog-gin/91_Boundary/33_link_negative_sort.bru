meta {
  name: 33 Link Negative Sort
  type: http
  seq: 33
}

post {
  url: {{baseUrl}}/api/links
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Boundary Negative Sort {{runId}}",
    "url": "https://example.com",
    "description": "",
    "sort": -1
  }
}

tests {
  test("link sort must not be negative", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("LINK_SORT_INVALID");
    expect(res.body.data).to.equal(null);
  });
}
