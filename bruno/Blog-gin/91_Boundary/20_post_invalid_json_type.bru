meta {
  name: 20 Post Invalid JSON Type
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": 123,
    "content": "content",
    "summary": "",
    "slug": "boundary-invalid-type-{{runId}}",
    "cover": "",
    "categoryId": "{{boundaryCategoryId}}",
    "tagIds": ["{{boundaryTagId}}"],
    "isPublished": true
  }
}

tests {
  test("post create rejects invalid json field type", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("INVALID_PARAMS");
    expect(res.body.data).to.equal(null);
  });
}
