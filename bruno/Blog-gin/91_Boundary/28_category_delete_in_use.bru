meta {
  name: 28 Category Delete In Use
  type: http
  seq: 28
}

delete {
  url: {{baseUrl}}/api/categories/{{boundaryCategoryId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("category used by post cannot be deleted", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal(409);
    expect(res.body.errorCode).to.equal("CATEGORY_IN_USE");
    expect(res.body.data).to.equal(null);
  });
}
