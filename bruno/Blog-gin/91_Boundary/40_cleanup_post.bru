meta {
  name: 40 Cleanup Post
  type: http
  seq: 40
}

delete {
  url: {{baseUrl}}/api/posts/{{boundaryPostId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("boundary post cleaned", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
  });
}
