meta {
  name: 02 Setup Tag
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Boundary Tag {{runId}}",
    "slug": "boundary-tag-{{runId}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("boundaryTagId", res.body.data.id);
  }
}

tests {
  test("boundary tag created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(bru.getVar("boundaryTagId")).to.be.a("string").and.not.empty;
  });
}
