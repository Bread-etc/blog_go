meta {
  name: 03 Category Duplicate Name
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Boundary Category {{runId}}",
    "slug": "boundary-category-dup-name-{{runId}}"
  }
}

tests {
  test("duplicate category name returns conflict", function () {
    expect(res.status).to.equal(409);
    expect(res.body.code).to.equal(409);
    expect(res.body.errorCode).to.equal("CATEGORY_NAME_EXISTS");
    expect(res.body.data).to.equal(null);
  });
}
