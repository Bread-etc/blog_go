meta {
  name: 03 Get Config After Update
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/config
  body: none
  auth: none
}

tests {
  test("config reflects update", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.title).to.equal(`Auto Blog ${bru.getVar("runId")}`);
    expect(res.body.data.githubUrl).to.equal("https://github.com/example");
  });
}

