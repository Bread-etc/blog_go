meta {
  name: 02 Setup Tag A
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/tags
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Post Tag A {{runId}}",
    "slug": "post-tag-a-{{runId}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("postTagIdA", res.body.data.id);
  }
}

tests {
  test("post tag a created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
  });
}

