meta {
  name: 06 Get Post Detail
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/posts/{{postSlug}}
  body: none
  auth: none
}

tests {
  test("post detail returns created post", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.equal(bru.getVar("postId"));
    expect(res.body.data.slug).to.equal(bru.getVar("postSlug"));
    expect(res.body.data.content).to.be.a("string").and.not.empty;
  });

  test("getting post detail does not increment views", function () {
    expect(String(res.body.data.views)).to.equal(bru.getVar("createdPostViews"));
  });
}

