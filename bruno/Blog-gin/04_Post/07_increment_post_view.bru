meta {
  name: 07 Increment Post View
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/posts/{{postId}}/views
  body: none
  auth: none
}

tests {
  test("post view increment succeeds", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.equal(null);
  });
}
