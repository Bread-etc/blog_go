meta {
  name: 01 Setup Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Post Category {{runId}}",
    "slug": "post-category-{{runId}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("postCategoryId", res.body.data.id);
  }
}

tests {
  test("post category created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
  });
}

