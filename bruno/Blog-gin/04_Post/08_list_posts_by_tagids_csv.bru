meta {
  name: 08 List Posts By TagIds CSV
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/posts?tagIds={{postTagIdA}},{{postTagIdB}}
  body: none
  auth: none
}

tests {
  test("csv tagIds query works like repeated tagIds", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.list).to.be.an("array");
    expect(res.body.data.list.some((item) => item.id === bru.getVar("postId"))).to.equal(true);
    expect(String(res.body.data.total)).to.equal(bru.getVar("repeatTagIdsTotal"));
  });
}

