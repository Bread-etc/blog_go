meta {
  name: 08 Get Post Detail After View
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/posts/{{postSlug}}
  body: none
  auth: none
}

tests {
  test("explicit view request increments views exactly once", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.equal(bru.getVar("postId"));
    expect(res.body.data.views).to.equal(Number(bru.getVar("createdPostViews")) + 1);
  });
}
