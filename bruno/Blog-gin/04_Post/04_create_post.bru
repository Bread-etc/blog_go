meta {
  name: 04 Create Post
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/posts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "title": "Auto Post {{runId}}",
    "content": "Auto post content generated by Bruno CLI.",
    "summary": "Auto post summary",
    "slug": "auto-post-{{runId}}",
    "cover": "",
    "categoryId": "{{postCategoryId}}",
    "tagIds": ["{{postTagIdA}}", "{{postTagIdB}}"],
    "isPublished": true
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("postId", res.body.data.id);
    bru.setVar("postSlug", res.body.data.slug);
    bru.setVar("createdPostViews", String(res.body.data.views));
  }
}

tests {
  test("post created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
    expect(res.body.data.slug).to.equal(`auto-post-${bru.getVar("runId")}`);
    expect(res.body.data.views).to.equal(0);
    expect(res.body.data.isPublished).to.equal(true);
    expect(res.body.data.category.id).to.equal(bru.getVar("postCategoryId"));
    expect(res.body.data.tags.map((item) => item.id)).to.include(bru.getVar("postTagIdA"));
    expect(res.body.data.tags.map((item) => item.id)).to.include(bru.getVar("postTagIdB"));
  });
}

