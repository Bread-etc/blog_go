meta {
  name: 05 List Posts
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/posts?page=1&pageSize=10
  body: none
  auth: none
}

tests {
  test("post list returns page response", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.list).to.be.an("array");
    expect(res.body.data.page).to.equal(1);
    expect(res.body.data.pageSize).to.equal(10);
    expect(res.body.data.list.some((item) => item.id === bru.getVar("postId"))).to.equal(true);
  });
}

