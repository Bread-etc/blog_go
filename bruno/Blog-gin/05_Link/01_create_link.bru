meta {
  name: 01 Create Link
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/links
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Auto Link {{runId}}",
    "url": "https://example.com/{{runId}}",
    "description": "Auto link generated by Bruno CLI",
    "sort": 10
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("linkId", res.body.data.id);
  }
}

tests {
  test("link created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
    expect(res.body.data.sort).to.equal(10);
  });
}

