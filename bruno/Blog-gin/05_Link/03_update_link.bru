meta {
  name: 03 Update Link
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/links/{{linkId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Auto Link Updated {{runId}}",
    "url": "https://example.org/{{runId}}",
    "description": "Auto link updated by Bruno CLI",
    "sort": 20
  }
}

tests {
  test("link updated", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.equal(null);
  });
}

