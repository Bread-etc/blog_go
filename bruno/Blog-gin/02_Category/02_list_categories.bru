meta {
  name: 02 List Categories
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/categories
  body: none
  auth: none
}

tests {
  test("category list returns array", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.be.an("array");
    expect(res.body.data.some((item) => item.id === bru.getVar("categoryId"))).to.equal(true);
  });
}

