meta {
  name: 03 Update Category
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/categories/{{categoryId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Auto Category Updated {{runId}}",
    "slug": "auto-category-updated-{{runId}}"
  }
}

tests {
  test("category updated", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.equal(null);
  });
}

