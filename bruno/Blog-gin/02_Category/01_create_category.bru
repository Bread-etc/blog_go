meta {
  name: 01 Create Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Auto Category {{runId}}",
    "slug": "auto-category-{{runId}}"
  }
}

script:pre-request {
  if (!bru.getVar("runId")) {
    bru.setVar("runId", Date.now().toString());
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("categoryId", res.body.data.id);
  }
}

tests {
  test("category created", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
    expect(res.body.data.slug).to.equal(`auto-category-${bru.getVar("runId")}`);
  });
}

