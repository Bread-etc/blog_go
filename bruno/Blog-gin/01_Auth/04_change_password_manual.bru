meta {
  name: 04 Change Password Manual
  type: http
  seq: 4
  tags: [
    manual
  ]
}

put {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const crypto = require("crypto");

  const publicKey = bru.getVar("publicKey");
  if (!publicKey) {
    throw new Error("publicKey is missing. Run 01 Get Public Key first.");
  }

  const oldPassword = bru.getEnvVar("adminPassword");
  const newPassword = bru.getEnvVar("newAdminPassword");

  if (!oldPassword || !newPassword) {
    throw new Error("Set adminPassword and newAdminPassword before running this manual request.");
  }

  if (oldPassword === newPassword) {
    throw new Error("newAdminPassword must be different from adminPassword.");
  }

  const encrypt = (password) => crypto.publicEncrypt(
    {
      key: publicKey,
      padding: crypto.constants.RSA_PKCS1_PADDING
    },
    Buffer.from(password, "utf8")
  ).toString("base64");

  req.setBody({
    oldPassword: encrypt(oldPassword),
    newPassword: encrypt(newPassword)
  });
}

tests {
  test("change password succeeds", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
  });
}
