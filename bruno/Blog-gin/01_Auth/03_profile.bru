meta {
  name: 03 Profile
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/auth/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("profile returns authenticated user", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.id).to.be.a("string").and.not.empty;
    expect(res.body.data.username).to.equal(bru.getEnvVar("adminUsername"));
    expect(res.body.data.role).to.equal("admin");
  });
}

