meta {
  name: 01 Get Public Key
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/auth/public-key
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    bru.setVar("publicKey", res.body.data.publicKey);
  }
}

tests {
  test("public key response is valid", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.publicKey).to.contain("BEGIN PUBLIC KEY");
  });
}

