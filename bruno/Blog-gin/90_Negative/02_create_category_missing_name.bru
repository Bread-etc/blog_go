meta {
  name: 02 Create Category Missing Name
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/categories
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "slug": "missing-name-{{runId}}"
  }
}

tests {
  test("missing category name returns business error", function () {
    expect(res.status).to.equal(400);
    expect(res.body.code).to.equal(400);
    expect(res.body.errorCode).to.equal("CATEGORY_NAME_REQUIRED");
    expect(res.body.data).to.equal(null);
  });
}

