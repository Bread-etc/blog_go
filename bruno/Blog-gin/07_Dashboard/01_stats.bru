meta {
  name: 01 Stats
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/dashboard/stats
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("dashboard stats returns cards", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data.posts).to.have.property("total");
    expect(res.body.data.posts).to.have.property("moMGrowth");
    expect(res.body.data).to.have.property("totalViews");
  });
}

