meta {
  name: 02 Top Posts Default
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/dashboard/top-posts
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("top posts default works", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.be.an("array");
    expect(res.body.data.length).to.be.at.most(5);
  });
}

