meta {
  name: 03 Top Posts Limit
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/dashboard/top-posts?limit=10
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

tests {
  test("top posts limit works", function () {
    expect(res.status).to.equal(200);
    expect(res.body.code).to.equal(200);
    expect(res.body.errorCode).to.equal("");
    expect(res.body.data).to.be.an("array");
    expect(res.body.data.length).to.be.at.most(10);
  });
}

